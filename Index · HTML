<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>ThreatWatch SOC Dashboard | Security Operations Center</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;600&family=Syne:wght@400;600;700;800&display=swap" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  :root {
    --bg: #0a0c10;
    --bg2: #0f1117;
    --bg3: #151820;
    --bg4: #1c2030;
    --border: rgba(255,255,255,0.07);
    --border2: rgba(255,255,255,0.12);
    --text: #e8ecf4;
    --text2: #8892a4;
    --text3: #4a5568;
    --accent: #00d4aa;
    --accent2: #0099ff;
    --red: #ff4757;
    --orange: #ff6b35;
    --yellow: #ffd32a;
    --purple: #9b59b6;
    --green: #00d4aa;
    --critical: #ff4757;
    --high: #ff6b35;
    --medium: #ffd32a;
    --low: #00d4aa;
    --info: #0099ff;
    --mono: 'JetBrains Mono', monospace;
    --sans: 'Syne', sans-serif;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: var(--mono);
    font-size: 13px;
    line-height: 1.5;
    min-height: 100vh;
    overflow-x: hidden;
  }

  /* SCANLINE EFFECT */
  body::before {
    content: '';
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px);
    pointer-events: none;
    z-index: 9999;
  }

  /* HEADER */
  .header {
    background: var(--bg2);
    border-bottom: 1px solid var(--border2);
    padding: 0 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .logo-icon {
    width: 32px;
    height: 32px;
    background: var(--accent);
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--sans);
    font-weight: 800;
    font-size: 14px;
    color: #0a0c10;
    flex-shrink: 0;
  }

  .logo-text {
    font-family: var(--sans);
    font-weight: 700;
    font-size: 16px;
    color: var(--text);
    letter-spacing: -0.3px;
  }

  .logo-sub {
    font-size: 10px;
    color: var(--text3);
    letter-spacing: 2px;
    text-transform: uppercase;
    font-family: var(--mono);
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .live-badge {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 1px;
  }

  .live-dot {
    width: 7px;
    height: 7px;
    background: var(--accent);
    border-radius: 50%;
    animation: pulse 1.5s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.4; transform: scale(0.8); }
  }

  .header-time {
    font-size: 11px;
    color: var(--text3);
    letter-spacing: 1px;
  }

  .threat-level-badge {
    padding: 4px 12px;
    border-radius: 4px;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .threat-level-badge.elevated {
    background: rgba(255,107,53,0.15);
    color: var(--orange);
    border: 1px solid rgba(255,107,53,0.3);
  }

  /* LAYOUT */
  .app {
    display: flex;
    height: calc(100vh - 56px);
  }

  /* SIDEBAR */
  .sidebar {
    width: 220px;
    flex-shrink: 0;
    background: var(--bg2);
    border-right: 1px solid var(--border);
    padding: 16px 0;
    overflow-y: auto;
  }

  .nav-section {
    padding: 0 12px;
    margin-bottom: 24px;
  }

  .nav-label {
    font-size: 9px;
    color: var(--text3);
    letter-spacing: 2px;
    text-transform: uppercase;
    padding: 0 8px;
    margin-bottom: 6px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 6px;
    cursor: pointer;
    color: var(--text2);
    font-size: 12px;
    transition: all 0.15s;
    margin-bottom: 2px;
  }

  .nav-item:hover { background: var(--bg3); color: var(--text); }
  .nav-item.active { background: rgba(0,212,170,0.1); color: var(--accent); border: 1px solid rgba(0,212,170,0.2); }

  .nav-icon { font-size: 14px; width: 16px; text-align: center; }

  .nav-badge {
    margin-left: auto;
    padding: 1px 6px;
    border-radius: 10px;
    font-size: 10px;
    background: rgba(255,71,87,0.2);
    color: var(--red);
    font-weight: 600;
  }

  .sidebar-stat {
    padding: 12px 20px;
    border-top: 1px solid var(--border);
    margin-top: 8px;
  }

  .sidebar-stat-label {
    font-size: 10px;
    color: var(--text3);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-bottom: 4px;
  }

  .sidebar-stat-value {
    font-size: 20px;
    font-weight: 600;
    color: var(--accent);
  }

  /* MAIN */
  .main {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
    background: var(--bg);
  }

  /* METRICS ROW */
  .metrics-row {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-bottom: 20px;
  }

  .metric-card {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    position: relative;
    overflow: hidden;
  }

  .metric-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
  }

  .metric-card.critical::before { background: var(--critical); }
  .metric-card.high::before { background: var(--high); }
  .metric-card.medium::before { background: var(--medium); }
  .metric-card.low::before { background: var(--low); }
  .metric-card.info::before { background: var(--info); }

  .metric-label {
    font-size: 9px;
    color: var(--text3);
    letter-spacing: 2px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  .metric-value {
    font-family: var(--sans);
    font-size: 28px;
    font-weight: 700;
    line-height: 1;
    margin-bottom: 4px;
  }

  .metric-card.critical .metric-value { color: var(--critical); }
  .metric-card.high .metric-value { color: var(--high); }
  .metric-card.medium .metric-value { color: var(--yellow); }
  .metric-card.low .metric-value { color: var(--accent); }
  .metric-card.info .metric-value { color: var(--info); }

  .metric-change {
    font-size: 10px;
    color: var(--text3);
  }

  .metric-change.up { color: var(--red); }
  .metric-change.down { color: var(--accent); }

  /* GRID */
  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px; }
  .grid-3 { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin-bottom: 16px; }
  .grid-full { margin-bottom: 16px; }

  /* PANEL */
  .panel {
    background: var(--bg2);
    border: 1px solid var(--border);
    border-radius: 8px;
    overflow: hidden;
  }

  .panel-header {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .panel-title {
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  .panel-actions {
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .btn-xs {
    padding: 3px 8px;
    border-radius: 4px;
    font-size: 10px;
    cursor: pointer;
    border: 1px solid var(--border2);
    background: var(--bg3);
    color: var(--text2);
    font-family: var(--mono);
    transition: all 0.15s;
    letter-spacing: 0.5px;
  }

  .btn-xs:hover { background: var(--bg4); color: var(--text); border-color: var(--accent); }

  .panel-body { padding: 16px; }

  /* ALERT TABLE */
  .alert-table { width: 100%; border-collapse: collapse; }

  .alert-table th {
    font-size: 9px;
    color: var(--text3);
    letter-spacing: 2px;
    text-transform: uppercase;
    text-align: left;
    padding: 6px 12px;
    border-bottom: 1px solid var(--border);
    background: var(--bg3);
  }

  .alert-table td {
    padding: 10px 12px;
    border-bottom: 1px solid var(--border);
    font-size: 12px;
    color: var(--text2);
    vertical-align: middle;
  }

  .alert-table tr:hover td { background: rgba(255,255,255,0.02); }
  .alert-table tr:last-child td { border-bottom: none; }

  /* SEVERITY BADGE */
  .sev {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 9px;
    font-weight: 600;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .sev-dot { width: 5px; height: 5px; border-radius: 50%; }
  .sev.critical { background: rgba(255,71,87,0.15); color: var(--critical); }
  .sev.critical .sev-dot { background: var(--critical); }
  .sev.high { background: rgba(255,107,53,0.15); color: var(--orange); }
  .sev.high .sev-dot { background: var(--orange); }
  .sev.medium { background: rgba(255,211,42,0.15); color: var(--yellow); }
  .sev.medium .sev-dot { background: var(--yellow); }
  .sev.low { background: rgba(0,212,170,0.15); color: var(--accent); }
  .sev.low .sev-dot { background: var(--accent); }

  /* STATUS */
  .status {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-size: 10px;
  }

  .status-dot { width: 6px; height: 6px; border-radius: 50%; }
  .status.new .status-dot { background: var(--red); animation: pulse 1.5s infinite; }
  .status.inv .status-dot { background: var(--yellow); }
  .status.closed .status-dot { background: var(--text3); }

  /* MITRE */
  .mitre-grid {
    display: grid;
    grid-template-columns: repeat(11, 1fr);
    gap: 3px;
    padding: 12px;
  }

  .mitre-tactic {
    text-align: center;
  }

  .mitre-tactic-name {
    font-size: 8px;
    color: var(--text3);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .mitre-tech {
    background: var(--bg3);
    border: 1px solid var(--border);
    border-radius: 3px;
    padding: 4px 3px;
    font-size: 8px;
    color: var(--text2);
    margin-bottom: 2px;
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
    line-height: 1.2;
  }

  .mitre-tech:hover { background: var(--bg4); border-color: var(--accent); color: var(--accent); }
  .mitre-tech.active-high { background: rgba(255,71,87,0.2); border-color: rgba(255,71,87,0.5); color: var(--critical); }
  .mitre-tech.active-med { background: rgba(255,107,53,0.15); border-color: rgba(255,107,53,0.4); color: var(--orange); }
  .mitre-tech.active-low { background: rgba(255,211,42,0.1); border-color: rgba(255,211,42,0.3); color: var(--yellow); }

  /* GEO THREAT MAP */
  .geo-list { padding: 8px 0; }

  .geo-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 16px;
    border-bottom: 1px solid var(--border);
  }

  .geo-item:last-child { border-bottom: none; }

  .geo-flag { font-size: 18px; width: 24px; }

  .geo-bar-wrap { flex: 1; }

  .geo-label {
    display: flex;
    justify-content: space-between;
    font-size: 10px;
    margin-bottom: 3px;
    color: var(--text2);
  }

  .geo-bar {
    height: 3px;
    background: var(--bg4);
    border-radius: 2px;
    overflow: hidden;
  }

  .geo-bar-fill {
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--accent2), var(--accent));
    transition: width 1.5s ease;
  }

  .geo-count {
    font-size: 11px;
    color: var(--text);
    font-weight: 600;
    min-width: 40px;
    text-align: right;
  }

  /* IOC TABLE */
  .ioc-row { display: flex; align-items: center; gap: 8px; padding: 8px 16px; border-bottom: 1px solid var(--border); }
  .ioc-row:last-child { border-bottom: none; }
  .ioc-type { font-size: 9px; padding: 2px 6px; border-radius: 3px; background: var(--bg3); color: var(--text3); letter-spacing: 1px; text-transform: uppercase; width: 46px; text-align: center; flex-shrink: 0; }
  .ioc-value { font-size: 11px; color: var(--accent2); font-family: var(--mono); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ioc-tag { font-size: 9px; padding: 2px 6px; border-radius: 3px; background: rgba(255,71,87,0.1); color: var(--red); border: 1px solid rgba(255,71,87,0.2); white-space: nowrap; }

  /* TIMELINE */
  .timeline { padding: 12px 16px; }
  .tl-item { display: flex; gap: 12px; padding: 8px 0; position: relative; }
  .tl-item:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 5px;
    top: 26px;
    width: 1px;
    height: calc(100% - 10px);
    background: var(--border2);
  }
  .tl-dot { width: 11px; height: 11px; border-radius: 50%; flex-shrink: 0; margin-top: 3px; border: 2px solid var(--bg2); }
  .tl-content { flex: 1; }
  .tl-title { font-size: 12px; color: var(--text); margin-bottom: 2px; }
  .tl-meta { font-size: 10px; color: var(--text3); }
  .tl-tag { display: inline-block; font-size: 9px; padding: 1px 5px; border-radius: 2px; background: var(--bg3); color: var(--text2); margin-right: 4px; }

  /* CHART CONTAINER */
  .chart-wrap { position: relative; height: 200px; }

  /* TERMINAL */
  .terminal {
    background: #060810;
    border-radius: 6px;
    padding: 16px;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.8;
    border: 1px solid var(--border);
    max-height: 200px;
    overflow-y: auto;
  }

  .term-line { display: flex; gap: 8px; }
  .term-time { color: var(--text3); flex-shrink: 0; }
  .term-sev-c { color: var(--critical); }
  .term-sev-h { color: var(--orange); }
  .term-sev-m { color: var(--yellow); }
  .term-msg { color: var(--text2); }
  .term-host { color: var(--accent2); }
  .term-ip { color: var(--accent); }

  /* SCORE RING */
  .score-ring-wrap {
    display: flex;
    align-items: center;
    gap: 20px;
    padding: 16px;
  }

  .score-ring {
    position: relative;
    width: 80px;
    height: 80px;
    flex-shrink: 0;
  }

  .score-ring svg { transform: rotate(-90deg); }
  .score-ring-val {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    font-family: var(--sans);
  }

  .score-num { font-size: 22px; font-weight: 700; color: var(--orange); }
  .score-max { font-size: 9px; color: var(--text3); }

  .score-details { flex: 1; }
  .score-detail-item { display: flex; justify-content: space-between; padding: 4px 0; border-bottom: 1px solid var(--border); font-size: 11px; }
  .score-detail-item:last-child { border-bottom: none; }
  .score-detail-label { color: var(--text3); }
  .score-detail-val { color: var(--text); font-weight: 600; }

  /* PLAYBOOK */
  .playbook { padding: 12px 16px; }
  .pb-step {
    display: flex;
    gap: 12px;
    padding: 8px 0;
    align-items: flex-start;
  }
  .pb-num {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--bg3);
    border: 1px solid var(--border2);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    color: var(--accent);
    flex-shrink: 0;
    font-weight: 600;
  }
  .pb-num.done { background: rgba(0,212,170,0.15); border-color: var(--accent); }
  .pb-title { font-size: 12px; color: var(--text); margin-bottom: 2px; }
  .pb-desc { font-size: 10px; color: var(--text3); }

  /* SCROLLBAR */
  ::-webkit-scrollbar { width: 4px; }
  ::-webkit-scrollbar-track { background: transparent; }
  ::-webkit-scrollbar-thumb { background: var(--bg4); border-radius: 2px; }

  /* ANIMATE IN */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .metrics-row { animation: fadeUp 0.4s ease both; }
  .grid-2 { animation: fadeUp 0.5s ease 0.1s both; }
  .grid-3 { animation: fadeUp 0.5s ease 0.15s both; }
  .grid-full { animation: fadeUp 0.5s ease 0.2s both; }

  /* SPARKLINE */
  .sparkline { display: flex; align-items: flex-end; gap: 2px; height: 24px; margin-top: 6px; }
  .spark-bar { flex: 1; border-radius: 1px; min-height: 2px; transition: height 0.3s; }

  /* SIGMA RULE */
  .sigma-box {
    background: #060810;
    border: 1px solid var(--border2);
    border-radius: 6px;
    padding: 14px 16px;
    font-size: 11px;
    line-height: 1.8;
    font-family: var(--mono);
    margin: 12px 16px;
  }

  .sig-key { color: var(--accent2); }
  .sig-val { color: var(--yellow); }
  .sig-str { color: var(--accent); }
  .sig-comment { color: var(--text3); }

  /* TABS */
  .tabs { display: flex; gap: 0; border-bottom: 1px solid var(--border); }
  .tab {
    padding: 10px 16px;
    font-size: 11px;
    color: var(--text3);
    cursor: pointer;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    letter-spacing: 0.5px;
    transition: all 0.15s;
  }
  .tab:hover { color: var(--text2); }
  .tab.active { color: var(--accent); border-bottom-color: var(--accent); }

  /* TAG */
  .tag { display: inline-block; padding: 2px 6px; border-radius: 3px; font-size: 9px; letter-spacing: 1px; text-transform: uppercase; }
  .tag-blue { background: rgba(0,153,255,0.1); color: var(--info); border: 1px solid rgba(0,153,255,0.2); }
  .tag-green { background: rgba(0,212,170,0.1); color: var(--accent); border: 1px solid rgba(0,212,170,0.2); }
  .tag-red { background: rgba(255,71,87,0.1); color: var(--red); border: 1px solid rgba(255,71,87,0.2); }
</style>
</head>
<body>

<!-- HEADER -->
<header class="header">
  <div class="logo">
    <div class="logo-icon">TW</div>
    <div>
      <div class="logo-text">ThreatWatch</div>
      <div class="logo-sub">Security Operations Center</div>
    </div>
  </div>
  <div class="header-right">
    <div class="live-badge">
      <div class="live-dot"></div>
      LIVE
    </div>
    <span class="threat-level-badge elevated">THREAT: ELEVATED</span>
    <div class="header-time" id="clock">2024-01-15 · 14:23:07 UTC</div>
  </div>
</header>

<div class="app">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <div class="nav-section">
      <div class="nav-label">Operations</div>
      <div class="nav-item active">
        <span class="nav-icon">◈</span> Dashboard
      </div>
      <div class="nav-item">
        <span class="nav-icon">⚡</span> Alert Queue
        <span class="nav-badge">23</span>
      </div>
      <div class="nav-item">
        <span class="nav-icon">⬡</span> Investigations
      </div>
      <div class="nav-item">
        <span class="nav-icon">◎</span> Hunt
      </div>
    </div>
    <div class="nav-section">
      <div class="nav-label">Intelligence</div>
      <div class="nav-item">
        <span class="nav-icon">◉</span> Threat Intel
      </div>
      <div class="nav-item">
        <span class="nav-icon">⊕</span> IOC Manager
      </div>
      <div class="nav-item">
        <span class="nav-icon">⋈</span> MITRE ATT&CK
      </div>
    </div>
    <div class="nav-section">
      <div class="nav-label">Detection</div>
      <div class="nav-item">
        <span class="nav-icon">◇</span> Sigma Rules
        <span class="nav-badge" style="background:rgba(0,153,255,0.2);color:var(--info);">12</span>
      </div>
      <div class="nav-item">
        <span class="nav-icon">⊞</span> Playbooks
      </div>
      <div class="nav-item">
        <span class="nav-icon">◌</span> Reports
      </div>
    </div>
    <div style="margin-top: auto;">
