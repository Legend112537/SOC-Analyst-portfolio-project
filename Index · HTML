tactics.forEach(t => {
  const col = document.createElement('div');
  col.className = 'mitre-tactic';
  col.innerHTML = `<div class="mitre-tactic-name">${t.name}</div>`;
  t.techs.forEach(tech => {
    if (!tech) { col.innerHTML += `<div style="height:28px"></div>`; return; }
    let cls = '';
    if (activeHigh.includes(tech)) cls = 'active-high';
    else if (activeMed.includes(tech)) cls = 'active-med';
    else if (activeLow.includes(tech)) cls = 'active-low';
    col.innerHTML += `<div class="mitre-tech ${cls}" title="${tech}">${tech}</div>`;
  });
  mitreGrid.appendChild(col);
});

// TABS
function switchTab(el, tab) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  el.classList.add('active');
  document.getElementById('tab-ioc').style.display = tab === 'ioc' ? 'block' : 'none';
  document.getElementById('tab-sigma').style.display = tab === 'sigma' ? 'block' : 'none';
}

// LIVE LOG
const events = [
  ['[CRIT]', 'crit', 'WIN-DC01', 'Ransomware file staging: C:\\ProgramData\\svhost32.exe', '14:23:07'],
  ['[HIGH]', 'high', 'LAB-SRV04', 'Inbound PsExec from 10.0.1.50 — remote execution', '14:22:51'],
  ['[HIGH]', 'high', 'WIN-DC01', 'LSASS memory read by unknown process (PID 4812)', '14:22:33'],
  ['[MED]',  'med',  'GW-EDGE01', 'DNS query to update-cdn[.]xyz — blocked by TI feed', '14:22:18'],
  ['[HIGH]', 'high', 'USR-PC042', 'PowerShell AMSI bypass detected — AmsiInitFailed', '14:21:55'],
  ['[MED]',  'med',  'WIN-WS011', 'Scheduled task created: \\Microsoft\\Update\\svcupd', '14:21:40'],
  ['[CRIT]', 'crit', 'DMZ-FW01',  'Outbound C2 beacon: 91.108.4.190:443 — Cobalt Strike JA3', '14:21:22'],
  ['[INFO]', 'info', 'MAIL-GW',   'Spearphishing email quarantined — malicious macro', '14:20:11'],
];

let streaming = true;
let logIdx = 0;
const terminal = document.getElementById('terminal');

function addLogLine() {
  if (!streaming) return;
  const e = events[logIdx % events.length];
  const div = document.createElement('div');
  div.className = 'term-line';
  const sevClass = e[1] === 'crit' ? 'term-sev-c' : e[1] === 'high' ? 'term-sev-h' : e[1] === 'med' ? 'term-sev-m' : 'sig-comment';
  div.innerHTML = `<span class="term-time">${e[4]}</span> <span class="${sevClass}">${e[0]}</span> <span class="term-host">${e[2]}</span> <span class="term-msg">— ${e[3]}</span>`;
  terminal.appendChild(div);
  while (terminal.children.length > 20) terminal.removeChild(terminal.firstChild);
  terminal.scrollTop = terminal.scrollHeight;
  logIdx++;
}

events.forEach(() => addLogLine());
setInterval(addLogLine, 2200);

function toggleStream() {
  streaming = !streaming;
  event.target.textContent = streaming ? '⏸ Pause' : '▶ Resume';
}

// EPS counter jitter
setInterval(() => {
  const eps = (7800 + Math.random() * 1200);
  document.getElementById('eps').textContent = (eps / 1000).toFixed(1) + 'k';
}, 3000);
</script>
