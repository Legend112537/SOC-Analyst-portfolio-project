  const max = Math.max(...data);
  data.forEach(v => {
    const bar = document.createElement('div');
    bar.className = 'spark-bar';
    const h = Math.max(2, Math.round((v / max) * 22));
    bar.style.cssText = `height:${h}px;background:${color};opacity:${0.3 + (v/max)*0.7}`;
    el.appendChild(bar);
  });
}

